target/
.git/
.gitignore
.idea/
.vscode/
*.iml
*.log
.env
.env.*
application-secrets.properties
README.md

# Server
server.port=8080
spring.application.name=Pocket_Health

# PostgreSQL
spring.datasource.url=jdbc:postgresql://127.0.0.1:5432/pocket_health
spring.datasource.username=postgres
spring.datasource.password=pass
spring.datasource.driver-class-name=org.postgresql.Driver

# SQL init (schema.sql) — runs before Hibernate's ddl-auto=validate check; idempotent CREATE TABLE IF NOT EXISTS
spring.sql.init.mode=always

# JPA / Hibernate
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect

# JWT
app.jwt.secret=Pocket_Health_spring_secret_key_2026_must_be_256bits_long
app.jwt.expiration=604800000

# API prefix
server.servlet.context-path=/api/v1

# =========================================================
# Actuator / Render Health Check
# =========================================================
management.endpoints.web.exposure.include=health
management.endpoint.health.show-details=never


spring.config.import=optional:classpath:application-secrets.properties
app.groq.api-key=${GROQ_API_KEY:}
app.groq.model=openai/gpt-oss-20b
app.groq.api-url=https://api.groq.com/openai/v1/chat/completions


## =========================================================
## APPLICATION
## =========================================================
#spring.application.name=Pocket_Health
#
#
## Render automatically provides PORT
#server.port=${PORT:8080}
#
## API prefix
#server.servlet.context-path=/api/v1
#
#
## =========================================================
## POSTGRESQL
## =========================================================
## Render provides:
## postgresql://user:password@host:port/database
## Spring JDBC requires:
## jdbc:postgresql://user:password@host:port/database
#
#spring.datasource.url=jdbc:${DATABASE_URL}
#spring.datasource.username=${DB_USERNAME}
#spring.datasource.password=${DB_PASSWORD}
#spring.datasource.driver-class-name=org.postgresql.Driver
#
#
## =========================================================
## SQL INITIALIZATION
## =========================================================
#spring.sql.init.mode=always
## Without this, ScriptUtils reads schema.sql using the platform default charset (cp1252 on
## Windows), which mangles any non-ASCII characters (e.g. em dashes) in seed data.
#spring.sql.init.encoding=UTF-8
#
#
#
## =========================================================
## JPA / HIBERNATE
## =========================================================
